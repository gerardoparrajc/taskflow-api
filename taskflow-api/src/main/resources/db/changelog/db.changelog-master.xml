<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="001-baseline" author="taskflow">
        <tagDatabase tag="taskflow-baseline" />
    </changeSet>

    <changeSet id="002-create-users" author="taskflow">
        <createTable tableName="users">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>

            <column name="email" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" />
            </column>

            <column name="password_hash" type="VARCHAR(100)">
                <constraints nullable="false" />
            </column>

            <column name="email_verified" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false" />
            </column>

            <column name="credential_version" type="BIGINT" defaultValueNumeric="1">
                <constraints nullable="false" />
            </column>

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

    <changeSet id="003-create-email-verification-tokens" author="taskflow">
        <createTable tableName="email_verification_tokens">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>

            <column name="user_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_email_verification_tokens_user"
                             references="users(id)"
                             deleteCascade="true" />
            </column>

            <!-- SHA-256 del token en hexadecimal: el token en claro nunca se guarda -->
            <column name="token_hash" type="VARCHAR(64)">
                <constraints nullable="false" unique="true" />
            </column>

            <column name="expires_at" type="TIMESTAMP">
                <constraints nullable="false" />
            </column>

            <column name="used_at" type="TIMESTAMP" />

            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>

        <createIndex tableName="email_verification_tokens" indexName="idx_email_verification_tokens_user">
            <column name="user_id" />
        </createIndex>
    </changeSet>
</databaseChangeLog>